# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------

# Required. Bot token from the Discord developer portal.
DISCORD_TOKEN=your_bot_token_here

# Guild to register slash commands in. Registering per-guild is instant;
# global registration (leave unset) takes up to an hour to propagate.
# DISCORD_GUILD_ID=123456789012345678

# Required. Discord user ID of the bot admin. Only this user can run /admin and
# save catalog imports; shop failures and "Wrong card" reports arrive as DMs to
# this user.
BOT_ADMIN_ID=123456789012345679

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Defaults to ./data/cards.db.
DB_PATH=./data/cards.db

# Override the migrations folder. Set in the Docker image, where the bot and
# its migrations do not sit at the repository paths. Leave unset for local
# development.
# MIGRATIONS_PATH=/app/src/bot/database/migrations

# ---------------------------------------------------------------------------
# Stock check
# ---------------------------------------------------------------------------

# Minutes between shop checks. Defaults to 60. Keep it at an hour or more: the
# shops are small and the check reads every page of each one. At most 35791
# (about 24 days, the longest a timer can wait).
# CHECK_INTERVAL_MINUTES=60

# eBay Browse API credentials (application keyset from developer.ebay.com).
# Set both, or neither (eBay is then skipped with a startup warning); only one of
# them set is a configuration error.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Image matching
# ---------------------------------------------------------------------------

# Hugging Face model used to compare listing pictures with the reference card
# image. Defaults to Xenova/dinov2-small, chosen with scripts/measure-threshold.ts
# (see docs/image-matching.md).
# IMAGE_MODEL=Xenova/dinov2-small

# Cosine similarity at or above which a listing picture confirms its card.
# Must be between 0 and 1 (exclusive). Defaults to 0.78, the measured
# fewest-errors point for Xenova/dinov2-small; re-measure when changing
# IMAGE_MODEL.
# IMAGE_MATCH_THRESHOLD=0.78

# Where model files are downloaded once and cached. Defaults to ./models.
# Pre-fill it with `./bin/mise run model:download`.
# MODEL_CACHE_DIR=./models

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of: error, warn, info, debug, trace. Defaults to info.
# LOG_LEVEL=info
