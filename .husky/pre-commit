#!/bin/sh

# Get the project root directory
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Scan for secrets with Gitleaks via local bin/mise
echo "🔐 Scanning for secrets with Gitleaks..."
"$PROJECT_ROOT/bin/mise" run gitleaks

if [ $? -ne 0 ]; then
  echo "❌ ERROR: Gitleaks detected secrets!"
  echo "   Please remove secrets before committing."
  exit 1
fi

# Check with ESLint through mise. Plain lint, not lint:fix: fixes made here would not be
# staged, so the commit would not contain them. Fix with `./bin/mise run lint:fix`, then
# stage and commit again.
echo "✨ Running linters..."
cd "$PROJECT_ROOT"
"$PROJECT_ROOT/bin/mise" run lint

if [ $? -ne 0 ]; then
  echo "❌ ERROR: Linting failed! Run ./bin/mise run lint:fix, stage the fixes and commit again."
  exit 1
fi

echo "✅ Pre-commit checks passed!"