#!/bin/sh
# Rejects a push that contains commits without a Signed-off-by trailer (DCO).
# POSIX sh only: this runs under `sh -e` from git, so no arrays or bashisms, and no
# unquoted expansion: every git argument is passed quoted, one per branch.

ZERO="0000000000000000000000000000000000000000"

if [ -z "$1" ]; then
  echo "Error: Remote not provided to pre-push hook"
  exit 1
fi

REMOTE="$1"
unsigned_count=0
unsigned_list=""
commits_file="$(mktemp)" || {
  echo "Error: cannot create a temporary file; cannot verify DCO sign-offs." >&2
  exit 1
}
trap 'rm -f "$commits_file"' EXIT

echo "Checking DCO sign-offs for commits being pushed..."

# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  : "$local_ref" "$remote_ref"
  if [ "$local_sha" = "$ZERO" ]; then
    # Deleting a remote ref: nothing to check.
    continue
  fi
  if [ "$remote_sha" = "$ZERO" ]; then
    # New remote ref: check only commits not already on any branch of the remote.
    if ! git rev-list "$local_sha" --not "--remotes=$REMOTE" >"$commits_file"; then
      echo "Error: git rev-list failed for new ref $local_sha; cannot verify DCO sign-offs." >&2
      exit 1
    fi
  else
    # Updating a ref: the commits it gains, less those already on any branch of the remote
    # (a branch rebased onto main gains main's commits, which were checked when they landed).
    if ! git rev-list "$remote_sha..$local_sha" --not "--remotes=$REMOTE" >"$commits_file"; then
      echo "Error: git rev-list failed for $remote_sha..$local_sha; cannot verify DCO sign-offs." >&2
      exit 1
    fi
  fi
  # Read from the file, not a pipe: a pipe runs the loop in a subshell and the counters
  # would not survive it.
  while read -r commit; do
    if ! git log --format=%B -n 1 "$commit" | grep -q "^Signed-off-by:"; then
      unsigned_count=$((unsigned_count + 1))
      unsigned_list="${unsigned_list}  - $(git log --oneline -n 1 "$commit")
"
    fi
  done <"$commits_file"
done

if [ "$unsigned_count" -gt 0 ]; then
  echo ""
  echo "DCO Check Failed"
  echo ""
  echo "The following commits are not signed off:"
  printf '%s' "$unsigned_list"
  echo ""
  echo "Please sign off on all commits using:"
  echo "  git commit --amend -s"
  echo ""
  echo "After amending, force-push with:"
  echo "  git push --force-with-lease"
  echo ""
  echo "For more information, see DCO.md"
  exit 1
fi

echo "All commits are properly signed off"
exit 0
